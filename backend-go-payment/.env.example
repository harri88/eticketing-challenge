# Payment Service Configuration - Example Template
# Copy this file to .env and update with your values

# Environment: development, staging, production
ENVIRONMENT=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=payment_db
DB_SSLMODE=disable

# Connection Pool Settings
# Maximum number of open connections to the database
DB_MAX_CONNS=25
# Minimum number of connections to keep open
DB_MIN_CONNS=5

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# Server binding address (0.0.0.0 for all interfaces)
SERVER_HOST=0.0.0.0
# Server port
SERVER_PORT=8081
# Request read timeout in seconds
SERVER_READ_TIMEOUT=10
# Response write timeout in seconds
SERVER_WRITE_TIMEOUT=10

# ==========================================
# EXTERNAL SERVICES
# ==========================================

# Ticket Service (E-Ticketing Backend)
# URL of the ticket service API
TICKET_SERVICE_URL=http://localhost:5020
# Timeout for ticket service requests in seconds
TICKET_SERVICE_TIMEOUT=30

# ==========================================
# PAYMENT GATEWAY CONFIGURATION
# ==========================================

# Default Payment Gateway Provider
# Supported: stripe, paypal, local
PAYMENT_GATEWAY_PROVIDER=stripe

# Stripe Configuration
# Get your API key from: https://dashboard.stripe.com/apikeys
# Test key format: sk_test_...
# Live key format: sk_live_...
STRIPE_API_KEY=sk_test_your_stripe_key_here

# PayPal Configuration
# Get credentials from: https://developer.paypal.com/dashboard/
# For sandbox: use sandbox.paypal.com credentials
# For production: use live paypal.com credentials
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here

# ==========================================
# LOGGING & DEBUG
# ==========================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
# Enable debug mode for verbose output
DEBUG=false
